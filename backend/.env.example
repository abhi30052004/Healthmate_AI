# =============================================================================
# HealthMate AI — Production Environment Variables Configuration (.env.example)
# =============================================================================

# Application Identity & Mode
APP_NAME=HealthMate AI
# Set to 'production' in live hosting environments (enforces security validations)
APP_ENV=production
API_PREFIX=/api

# Managed PostgreSQL Database URL (Requires pgvector extension)
# Example Neon/RDS/Supabase connection string with SSL:
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Allowed CORS Origins (Comma-separated exact origins; wildcards forbidden in production)
FRONTEND_ORIGINS=https://app.healthmate.ai,https://healthmate.yourdomain.com

# Cryptographic Authentication Secrets
# Generate a secure 32+ byte key (e.g. `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=generate-and-set-a-cryptographically-random-32-char-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Persistent Private Document Storage Directory
# Must point to a mounted persistent volume or persistent disk directory (e.g. /var/data/healthmate_uploads)
DOCUMENT_STORAGE_DIR=/var/data/healthmate_uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Medical AI Chat & RAG Settings (Optional: defaults to offline fallback without keys)
MEDICAL_CHAT_PROVIDER=fallback
MEDICAL_CHAT_MODEL=gemini-1.5-flash
MEDICAL_CHAT_API_KEY=
# Alternative provider keys:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
MEDICAL_CHAT_REQUEST_TIMEOUT=30
MEDICAL_CHAT_MAX_CONTEXT_ITEMS=15

# Optional Notification Delivery Settings (In-app delivery operates natively without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@healthmate.ai
SMTP_USE_TLS=true

